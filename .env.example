# Required: set this to an existing local Obsidian vault directory.
# Keep this value local; never commit a personal or shared vault path.
HLM_VAULT_PATH=

# Optional vault scope. The default index root is the whole vault.
HLM_INDEX_ROOT=.
# JSON array of vault-relative folder rules. Reads allow by default; writes are
# policy-controlled (proposal/approval or auto-write under these folder rules).
HLM_FOLDER_RULES=[]
# Optional embedding model.
HLM_EMBEDDING_MODEL=
# Optional short-term memory tuning (defaults shown; cache writes stay local).
HLM_SHORT_TERM_CAPACITY=50
HLM_SHORT_TERM_TTL_DAYS=14
HLM_SHORT_TERM_MAX_BOOST=0.25
# Relative SQLite paths resolve under ~/.config/harbor-ledger-memory, not the
# process CWD. Absolute DATABASE_URL values are used unchanged.
DATABASE_URL=sqlite:///data/memory.db
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# Server features are disabled by default. `hlm serve` refuses to bind until
# the frontend is enabled. Restart the service after changing configuration.
HLM_FRONTEND__ENABLED=false
HLM_FRONTEND__MODE=loopback
HLM_FRONTEND__PUBLIC_ORIGIN=
# Never put a plaintext password here. Run `hlm config set-password` to store
# an Argon2id verifier in the owner-only TOML config.

# LAN mode (choose HTTPS, or explicitly acknowledge insecure HTTP):
HLM_NETWORK__ENABLED=false
HLM_NETWORK__TLS_CERT=
HLM_NETWORK__TLS_KEY=
HLM_NETWORK__INSECURE_HTTP=false
# Optional JSON array, for example: ["192.168.1.0/24"]
HLM_NETWORK__ALLOWED_CIDRS=[]

# Bearer transports are independent and disabled by default.
HLM_API__ENABLED=false
HLM_MCP__ENABLED=false
# API tokens live in the catalog database, not in process variables —
# manage them with `hlm token …` or the authenticated UI.
